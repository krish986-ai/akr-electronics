rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Keep this literal in sync with CREATOR_EMAIL in lib/auth/creator.ts —
    // rules run in a separate runtime and can't import that constant. The
    // creator's placeholder address can never receive a real verification
    // email, so it's exempted here the same way it's exempted in code.
    function isCreator() {
      return isSignedIn() && request.auth.token.email == 'smart@gmail.com';
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || isCreator());
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Public catalog — readable by everyone, writable only by admins
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /brands/{id} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /kits/{id} { allow read: if true; allow write: if isAdmin(); }
    match /coupons/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /config/{id} { allow read: if true; allow write: if isAdmin(); }

    // Reviews: everyone reads approved content via queries; signed-in users
    // create; only admins moderate/delete
    match /reviews/{id} {
      allow read: if true;
      allow create: if isVerified();
      allow update, delete: if isAdmin();
    }
    match /questions/{id} {
      allow read: if true;
      allow create: if isVerified();
      allow update, delete: if isAdmin();
    }

    // User documents and subcollections (addresses, wishlist).
    // Owners manage their own profile but can never grant themselves a role;
    // role changes go through the admin API (Admin SDK bypasses these rules).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() ||
        (isOwner(userId) && request.resource.data.get('role', 'CUSTOMER') == 'CUSTOMER');
      allow update: if isAdmin() ||
        (isOwner(userId) &&
          request.resource.data.get('role', 'CUSTOMER') == resource.data.get('role', 'CUSTOMER'));
      allow delete: if isAdmin();
      match /{sub=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Carts keyed by user id
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      match /{sub=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Orders: customers create and read their own; admins manage all
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
      match /{sub=**} {
        allow read, write: if isAdmin();
      }
    }

    // Secondary admin action password (lib/auth/admin-password.ts). Never
    // matched below on purpose — only the Admin SDK (which bypasses rules
    // entirely) may touch it; no client, admin or otherwise, ever should.
    match /adminSecrets/{id} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
