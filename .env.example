# ============================================================================
# DEPLOYMENT (Vercel)
# ============================================================================
# Set every variable below in the Vercel dashboard:
# Project Settings > Environment Variables (Production + Preview)
# Vercel sets VERCEL=1 automatically, which switches file uploads from local
# disk (dev only) to Firebase Storage. To force Firebase Storage locally:
STORAGE_PROVIDER=""

# ============================================================================
# FIREBASE (Auth + Firestore + Storage)
# ============================================================================
# Get these from Firebase Console > Project Settings
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin SDK (Server-side only - DO NOT EXPOSE TO BROWSER)
FIREBASE_ADMIN_PRIVATE_KEY=""
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""

# Set to "true" only after android/app/google-services.json has been added and
# the APK rebuilt. Until then this must stay unset — the native
# push-notifications plugin crashes without a real FirebaseApp.
NEXT_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=""

# ============================================================================
# SESSION & SECURITY
# ============================================================================
# Random secret for session management
SESSION_SECRET="your-random-secret-key-here-min-32-chars"

# Session expiry time in milliseconds (default: 30 days)
SESSION_EXPIRY_MS="2592000000"

# ============================================================================
# RAZORPAY PAYMENT
# ============================================================================
# Names must match exactly — app/api/orders/place, app/api/payments/razorpay/order
# and app/api/admin/payment-settings all read these two.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ============================================================================
# EMAIL (Resend — free tier: 100 emails/day, 3,000/month)
# ============================================================================
# Get an API key at https://resend.com after verifying a sending domain.
# Order confirmation emails are skipped (not failed) while this is empty —
# see lib/email/resend.ts.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="A.K.R Electronics <orders@akrelectronics.com>"

# ============================================================================
# APPLICATION
# ============================================================================
NEXT_PUBLIC_APP_NAME="A.K.R Electronics"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ============================================================================
# ADMIN CONFIGURATION
# ============================================================================
# Email of the primary admin user (created during initial setup)
ADMIN_EMAIL="admin@akrelectronics.com"

# Seeds the secondary admin action password (lib/auth/admin-password.ts) the
# first time it's read — after that the value lives in Firestore
# (adminSecrets/action) and is rotated from Admin > Creator, not from here.
ADMIN_ACTION_PASSWORD_DEFAULT=""
